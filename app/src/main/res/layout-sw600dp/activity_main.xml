<?xml version="1.0" encoding="utf-8"?>
<!-- Smallest width >= 600dp: this tablet layout wins in both orientations. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="@dimen/tablet_outer_padding"
    android:tag="tablet_sw600dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/tablet_pane_gap"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lab_title"
            style="@style/TabletText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/black"
            android:text="@string/lab_title" />

        <TextView
            android:id="@+id/layout_title"
            style="@style/TabletText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="@dimen/tablet_content_padding"
            android:background="@color/white"
            android:text="@string/layout_title"
            android:textColor="@color/black" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/words"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/word_this"
                style="@style/TabletText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/word_red"
                android:text="@string/word_this" />
            <TextView
                android:id="@+id/word_is"
                style="@style/TabletText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/word_blue"
                android:text="@string/word_is" />
            <TextView
                android:id="@+id/word_my"
                style="@style/TabletText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/word_purple"
                android:text="@string/word_my" />
            <TextView
                android:id="@+id/word_first"
                style="@style/TabletText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/word_yellow"
                android:text="@string/word_first"
                android:textColor="@color/black" />
        </LinearLayout>

        <TextView
            android:id="@+id/application_title"
            style="@style/TabletText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:background="@color/black"
            android:text="@string/application_title" />

        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="@dimen/tablet_content_padding">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/change_button"
                style="@style/TabletButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/change" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_button"
                style="@style/TabletButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/cancel" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
